{
  "manifest_version": 3,
  "name": "WhiskerFlow Meet speakers",
  "version": "0.1.0",
  "description": "Passes Google Meet speaker identity to local WhiskerFlow recordings without captions.",
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "meet-protocol.js",
        "observe.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start"
    }
  ],
  "key": ""
}
